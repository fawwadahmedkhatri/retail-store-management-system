// Production database schema (PostgreSQL). The demo runs the same model in the browser;
// go-live swaps src/lib/store.tsx actions for server actions backed by these tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  role         Role          @default(STAFF)
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  sales        Sale[]
  returns      SaleReturn[]
  stockEntries StockEntry[]
  activity     ActivityLog[]
}

model Product {
  id           String       @id @default(cuid())
  sku          String       @unique
  barcode      String?      @unique
  name         String
  category     String
  brand        String?
  costExGst    Decimal      @db.Decimal(10, 2)
  priceIncGst  Decimal      @db.Decimal(10, 2)
  qty          Int          @default(0)
  reorderLevel Int          @default(5)
  deletedAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  saleLines    SaleLine[]
  stockEntries StockEntry[]

  @@index([name])
  @@index([category])
}

model Customer {
  id        String    @id @default(cuid())
  name      String
  phone     String?
  email     String?
  suburb    String?
  notes     String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  sales     Sale[]

  @@index([phone])
}

model Sale {
  id           String        @id @default(cuid())
  invoiceNo    String        @unique
  date         DateTime      @default(now())
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  customerId   String?
  customer     Customer?     @relation(fields: [customerId], references: [id])
  cartDiscount Decimal       @default(0) @db.Decimal(10, 2)
  subtotal     Decimal       @db.Decimal(10, 2)
  total        Decimal       @db.Decimal(10, 2)
  gst          Decimal       @db.Decimal(10, 2)
  payment      PaymentMethod
  tendered     Decimal?      @db.Decimal(10, 2)
  lines        SaleLine[]
  returns      SaleReturn[]

  @@index([date])
}

model SaleLine {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  sku       String
  name      String
  qty       Int
  unitPrice Decimal @db.Decimal(10, 2) // inc GST, snapshotted at sale time
  unitCost  Decimal @db.Decimal(10, 2) // ex GST, snapshotted for accurate profit
  discount  Decimal @default(0) @db.Decimal(10, 2)
}

model SaleReturn {
  id           String        @id @default(cuid())
  returnNo     String        @unique
  saleId       String
  sale         Sale          @relation(fields: [saleId], references: [id])
  date         DateTime      @default(now())
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  reason       String
  refundMethod PaymentMethod
  restocked    Boolean
  total        Decimal       @db.Decimal(10, 2)
  lines        Json // [{ productId, qty, refund, unitCost }]
}

model StockEntry {
  id        String   @id @default(cuid())
  date      DateTime @default(now())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  qty       Int
  costExGst Decimal  @db.Decimal(10, 2)
  supplier  String?
  reference String?
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

model ActivityLog {
  id       String   @id @default(cuid())
  at       DateTime @default(now())
  userId   String?
  user     User?    @relation(fields: [userId], references: [id])
  action   String // created | updated | deleted | sale | return | stock-in | import | login
  entity   String
  entityId String
  summary  String
  changes  Json? // [{ field, from, to }]

  @@index([at])
  @@index([entity, entityId])
}

model Settings {
  id              Int     @id @default(1)
  name            String
  abn             String
  address         String
  phone           String
  email           String
  logoUrl         String?
  receiptFooter   String
  lowStockDefault Int     @default(5)
}
